# Settings for docker-compose.yml. Copy to .env.docker and fill in the two secrets.

# Generate with: docker compose run --rm --no-deps --entrypoint php mcp artisan key:generate --show
APP_KEY=
APP_NAME="Easy!Appointments MCP"

# The API token you set in Easy!Appointments under Settings > Integrations > API.
# demo/setup.sh writes this same value into the demo instance for you.
EA_API_TOKEN=

# The demo account people sign in with on the consent screen. Shown on the home page when set.
DEMO_EMAIL=frontdesk@demo.test
DEMO_PASSWORD=demo-password-1
