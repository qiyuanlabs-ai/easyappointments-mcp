{
	# TLS is normally ended by a load balancer or a reverse proxy in front of this container.
	# Set SERVER_NAME to your domain (for example mcp.example.com) to let Caddy get a certificate itself.
	frankenphp
	admin off
	# The container runs as an unprivileged user, so it listens on high ports.
	# Map host ports 80 and 443 to these when Caddy handles HTTPS itself.
	http_port {$CADDY_HTTP_PORT:8080}
	https_port {$CADDY_HTTPS_PORT:8443}
}

{$SERVER_NAME::8080} {
	root * /app/public
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	php_server
}
