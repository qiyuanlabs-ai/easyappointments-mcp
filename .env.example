APP_NAME="Easy!Appointments MCP"
APP_ENV=local
APP_KEY=
# Never true on a server people can reach: debug pages show configuration and stack traces.
APP_DEBUG=false
# The public address of this server. OAuth metadata and redirects are built from it.
APP_URL=http://localhost:8000

# Behind a load balancer or reverse proxy: its IPs or CIDRs, comma separated, or *.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite is fine for one business. Use mysql or pgsql for more.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Easy!Appointments allows 100 API requests per IP every 2 minutes, so the server caches
# and limits lookups. Raise these only if you changed that limit in Easy!Appointments.
EA_HTTP_TIMEOUT=10
EA_CATALOG_CACHE_SECONDS=600
EA_AVAILABILITY_CACHE_SECONDS=60
EA_MAX_AVAILABILITY_LOOKUPS=21

MCP_REQUESTS_PER_MINUTE=60
MCP_LOG_RETENTION_DAYS=90

# Only for a public demo: shows this login on the home page.
DEMO_EMAIL=
DEMO_PASSWORD=
